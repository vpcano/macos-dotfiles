#!/usr/bin/env zsh

sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

yabai -m config external_bar               all:42:0       \
								menubar_opacity						 0.0            \
                mouse_follows_focus        off            \
                focus_follows_mouse        autofocus      \
                window_zoom_persist        off            \
                window_placement           second_child   \
                window_shadow              on		          \
                window_opacity             off            \
                window_animation_duration  0.3            \
                window_animation_easing    ease_out_quint \
                insert_feedback_color      0xff9dd274     \
                split_ratio                0.50           \
                auto_balance               off            \
                mouse_modifier             fn             \
                mouse_action1              move           \
                mouse_action2              resize         \
                mouse_drop_action          swap           \
                                                          \
                top_padding                12             \
                bottom_padding             12             \
                left_padding               12             \
                right_padding              12             \
                window_gap                 15


                # window_opacity_duration    0.2            \
                # active_window_opacity      1.0            \
                # normal_window_opacity      0.85           \

# Exclude problematic apps from being managed:
yabai -m rule --add app="^(LuLu|Spotify|Calculator|Software Update|Dictionary|VLC|System Preferences|System Settings|zoom.us|Photo Booth|Archive Utility|Python|LibreOffice|App Store|Steam|Alfred|WhatsApp|Activity Monitor)$" manage=off
yabai -m rule --add app="^(LuLu|Spotify|Calculadora|Actualización de Software|Diccionario|VLC|Preferencias del Sistema|Ajustes del Sistema|zoom.us|Photo Booth|Utilidad de Archivos|Python|LibreOffice|App Store|Steam|Alfred|WhatsApp|Monitor de Actividad)$" manage=off
yabai -m rule --add label="Finder" app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref)" manage=off
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off
yabai -m rule --add label="Select file to save to" app="^Inkscape$" title="Select file to save to" manage=off

yabai -m config layout bsp

# Focus window under cursor when no window is focused after destroy/minimize/hide
function focus_under_cursor {
  if yabai -m query --windows --space |
      jq -er 'map(select(.focused == 1)) | length == 0' >/dev/null; then
    yabai -m window --focus mouse 2>/dev/null || true
  fi
}

yabai -m signal --add event=window_destroyed    action="${functions[focus_under_cursor]}"
yabai -m signal --add event=window_minimized    action="${functions[focus_under_cursor]}"
yabai -m signal --add event=application_hidden  action="${functions[focus_under_cursor]}"

borders active_color=0xffffffff inactive_color=0x00000000 width=3.0 hidpi=on &
