# =============================================================================
# skhd — window management on HYPER; Option/Alt stays free for apps
#
# Karabiner-Elements maps the Caps Lock key:
#   hold Caps Lock  =>  alt + cmd          ("hyper")
#   tap  Caps Lock  =>  real Caps Lock
#
# Hold Caps and ADD a modifier to pick the action tier — mirrors the old
# lalt / shift+lalt / ctrl+lalt layout exactly:
#   Caps + hjkl/arrows        = focus    (was lalt + hjkl/arrows)
#   Shift + Caps + hjkl/arrows = warp    (was shift + lalt + …)
#   Ctrl  + Caps + hjkl/arrows = resize  (was ctrl + lalt + …)
#
# Physical alt / ctrl+alt are intentionally unbound: they belong to apps
# (tmux/neovim use ctrl+alt+hjkl for split resizing).
# Previous configs: ~/.config/skhd/skhdrc.bak
#
# NOTE: skhd now owns cmd+alt+<these keys> globally, so app shortcuts like
# ⌘⌥H (hide others) on h/j/k/l/q/f/e/g/w/r/tab/return/digits/arrows are
# shadowed — the WM action runs instead.
# =============================================================================

# --- focus window / display ---------------------------------------------------
alt + cmd - h     : yabai -m window --focus west  || yabai -m display --focus west
alt + cmd - j     : yabai -m window --focus south || yabai -m display --focus south
alt + cmd - k     : yabai -m window --focus north || yabai -m display --focus north
alt + cmd - l     : yabai -m window --focus east  || yabai -m display --focus east
alt + cmd - left  : yabai -m window --focus west  || yabai -m display --focus west
alt + cmd - right : yabai -m window --focus east  || yabai -m display --focus east
alt + cmd - up    : yabai -m window --focus north || yabai -m display --focus north
alt + cmd - down  : yabai -m window --focus south || yabai -m display --focus south

# --- focus space ---------------------------------------------------------------
alt + cmd - 1 : yabai -m space --focus 1
alt + cmd - 2 : yabai -m space --focus 2
alt + cmd - 3 : yabai -m space --focus 3
alt + cmd - 4 : yabai -m space --focus 4
alt + cmd - 5 : yabai -m space --focus 5
alt + cmd - 6 : yabai -m space --focus 6
alt + cmd - 7 : yabai -m space --focus 7
alt + cmd - 8 : yabai -m space --focus 8
alt + cmd - 9 : yabai -m space --focus 9
alt + cmd - 0 : yabai -m space --focus 10

# --- window actions --------------------------------------------------------------
alt + cmd - q : WIN=$(yabai -m query --windows --window | jq -r '.id') && (yabai -m window --focus recent 2>/dev/null || yabai -m window --focus east 2>/dev/null || yabai -m window --focus west 2>/dev/null || yabai -m window --focus north 2>/dev/null || yabai -m window --focus south 2>/dev/null || true) && yabai -m window "$WIN" --close
alt + cmd - f : yabai -m window --toggle float
shift + alt + cmd - f : yabai -m window --toggle zoom-fullscreen
alt + cmd - tab : yabai -m window --toggle split

# --- warp window (swap with neighbor / move to display) --------------------------
shift + alt + cmd - h     : yabai -m window --warp west  || (yabai -m window --display west  && yabai -m display --focus west)
shift + alt + cmd - j     : yabai -m window --warp south || (yabai -m window --display south && yabai -m display --focus south)
shift + alt + cmd - k     : yabai -m window --warp north || (yabai -m window --display north && yabai -m display --focus north)
shift + alt + cmd - l     : yabai -m window --warp east  || (yabai -m window --display east  && yabai -m display --focus east)
shift + alt + cmd - left  : yabai -m window --warp west  || (yabai -m window --display west  && yabai -m display --focus west)
shift + alt + cmd - right : yabai -m window --warp east  || (yabai -m window --display east  && yabai -m display --focus east)
shift + alt + cmd - up    : yabai -m window --warp north || (yabai -m window --display north && yabai -m display --focus north)
shift + alt + cmd - down  : yabai -m window --warp south || (yabai -m window --display south && yabai -m display --focus south)

# --- move window to space ----------------------------------------------------------
shift + alt + cmd - 1 : yabai -m window --space 1 && yabai -m space --focus 1
shift + alt + cmd - 2 : yabai -m window --space 2 && yabai -m space --focus 2
shift + alt + cmd - 3 : yabai -m window --space 3 && yabai -m space --focus 3
shift + alt + cmd - 4 : yabai -m window --space 4 && yabai -m space --focus 4
shift + alt + cmd - 5 : yabai -m window --space 5 && yabai -m space --focus 5
shift + alt + cmd - 6 : yabai -m window --space 6 && yabai -m space --focus 6
shift + alt + cmd - 7 : yabai -m window --space 7 && yabai -m space --focus 7
shift + alt + cmd - 8 : yabai -m window --space 8 && yabai -m space --focus 8
shift + alt + cmd - 9 : yabai -m window --space 9 && yabai -m space --focus 9

# --- resize window (Ctrl + Caps + direction) ----------------------------------------
ctrl + alt + cmd - h     : yabai -m window --resize right:-100:0  || yabai -m window --resize left:-100:0
ctrl + alt + cmd - j     : yabai -m window --resize bottom:0:100  || yabai -m window --resize top:0:100
ctrl + alt + cmd - k     : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
ctrl + alt + cmd - l     : yabai -m window --resize right:100:0   || yabai -m window --resize left:100:0
ctrl + alt + cmd - left  : yabai -m window --resize right:-100:0  || yabai -m window --resize left:-100:0
ctrl + alt + cmd - down  : yabai -m window --resize bottom:0:100  || yabai -m window --resize top:0:100
ctrl + alt + cmd - up    : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
ctrl + alt + cmd - right : yabai -m window --resize right:100:0   || yabai -m window --resize left:100:0

# --- layout --------------------------------------------------------------------------
alt + cmd - e : yabai -m space --balance
alt + cmd - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# --- apps & misc -----------------------------------------------------------------------
alt + cmd - return -> : kitty -1 ~
alt + cmd - w : open -a "Zen"
alt + cmd - r : skhd -k "cmd - space"
shift + alt + cmd - s : screencapture -i -c
shift + ctrl + alt + cmd - delete : pmset sleepnow
