## ── NAVIGATION (lalt) ──────────────────────────────────────────────────────

# Focus window: lalt - {h, j, k, l} / arrows
lalt - h     : yabai -m window --focus west  || yabai -m display --focus west
lalt - j     : yabai -m window --focus south || yabai -m display --focus south
lalt - k     : yabai -m window --focus north || yabai -m display --focus north
lalt - l     : yabai -m window --focus east  || yabai -m display --focus east
lalt - left  : yabai -m window --focus west  || yabai -m display --focus west
lalt - right : yabai -m window --focus east  || yabai -m display --focus east
lalt - up    : yabai -m window --focus north || yabai -m display --focus north
lalt - down  : yabai -m window --focus south || yabai -m display --focus south

# Space (workspace) switch: lalt - {1..9, 0}
lalt - 1 : yabai -m space --focus 1
lalt - 2 : yabai -m space --focus 2
lalt - 3 : yabai -m space --focus 3
lalt - 4 : yabai -m space --focus 4
lalt - 5 : yabai -m space --focus 5
lalt - 6 : yabai -m space --focus 6
lalt - 7 : yabai -m space --focus 7
lalt - 8 : yabai -m space --focus 8
lalt - 9 : yabai -m space --focus 9
lalt - 0 : yabai -m space --focus 10

## ── WINDOW MANAGEMENT (lalt) ───────────────────────────────────────────────

# Close window: lalt - q
lalt - q : WIN=$(yabai -m query --windows --window | jq -r '.id') && (yabai -m window --focus recent 2>/dev/null || yabai -m window --focus east 2>/dev/null || yabai -m window --focus west 2>/dev/null || yabai -m window --focus north 2>/dev/null || yabai -m window --focus south 2>/dev/null || true) && yabai -m window "$WIN" --close

# Toggle float: lalt - f
lalt - f : yabai -m window --toggle float

# Toggle fullscreen: shift + lalt - f
shift + lalt - f : yabai -m window --toggle zoom-fullscreen

# Toggle split orientation: lalt - s
lalt - tab : yabai -m window --toggle split

## ── MOVE WINDOWS (shift + lalt) ────────────────────────────────────────────

# Warp window in direction: shift + lalt - {h, j, k, l} / arrows
shift + lalt - h     : yabai -m window --warp west  || (yabai -m window --display west  && yabai -m display --focus west)
shift + lalt - j     : yabai -m window --warp south || (yabai -m window --display south && yabai -m display --focus south)
shift + lalt - k     : yabai -m window --warp north || (yabai -m window --display north && yabai -m display --focus north)
shift + lalt - l     : yabai -m window --warp east  || (yabai -m window --display east  && yabai -m display --focus east)
shift + lalt - left  : yabai -m window --warp west  || (yabai -m window --display west  && yabai -m display --focus west)
shift + lalt - right : yabai -m window --warp east  || (yabai -m window --display east  && yabai -m display --focus east)
shift + lalt - up    : yabai -m window --warp north || (yabai -m window --display north && yabai -m display --focus north)
shift + lalt - down  : yabai -m window --warp south || (yabai -m window --display south && yabai -m display --focus south)

# Move window to space: shift + lalt - {1..8}
shift + lalt - 1 : yabai -m window --space 1 && yabai -m space --focus 1
shift + lalt - 2 : yabai -m window --space 2 && yabai -m space --focus 2
shift + lalt - 3 : yabai -m window --space 3 && yabai -m space --focus 3
shift + lalt - 4 : yabai -m window --space 4 && yabai -m space --focus 4
shift + lalt - 5 : yabai -m window --space 5 && yabai -m space --focus 5
shift + lalt - 6 : yabai -m window --space 6 && yabai -m space --focus 6
shift + lalt - 7 : yabai -m window --space 7 && yabai -m space --focus 7
shift + lalt - 8 : yabai -m window --space 8 && yabai -m space --focus 8

## ── RESIZE (ctrl + lalt) ────────────────────────────────────────────────────

ctrl + lalt - h     : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
ctrl + lalt - j     : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
ctrl + lalt - k     : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
ctrl + lalt - l     : yabai -m window --resize right:100:0  || yabai -m window --resize left:100:0
ctrl + lalt - left  : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
ctrl + lalt - right : yabai -m window --resize right:100:0  || yabai -m window --resize left:100:0
ctrl + lalt - up    : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
ctrl + lalt - down  : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100

# Balance all windows: ctrl + lalt - e
ctrl + lalt - e : yabai -m space --balance

# Toggle gaps: ctrl + lalt - g
ctrl + lalt - g : yabai -m space --toggle padding; yabai -m space --toggle gap

## ── STACKS (shift + ctrl) ───────────────────────────────────────────────────

# shift + ctrl - h : yabai -m window west  --stack $(yabai -m query --windows --window | jq -r '.id')
# shift + ctrl - j : yabai -m window south --stack $(yabai -m query --windows --window | jq -r '.id')
# shift + ctrl - k : yabai -m window north --stack $(yabai -m query --windows --window | jq -r '.id')
# shift + ctrl - l : yabai -m window east  --stack $(yabai -m query --windows --window | jq -r '.id')
#
# Stack navigation: shift + ctrl - {n, p}
# shift + ctrl - n : yabai -m window --focus stack.next
# shift + ctrl - p : yabai -m window --focus stack.prev

## ── APPS ────────────────────────────────────────────────────────────────────

# Terminal: lalt - return
# lalt - return -> : open -a Ghostty.app --args --quit-after-last-window-closed=true
lalt - return -> : kitty -1 ~

# Spotlight launcher: lalt - r
lalt - r : skhd -k "cmd - space"

# Area screenshot → clipboard: shift + lalt - s
shift + lalt - s : screencapture -i -c

# Lock screen: ctrl + lalt - l
ctrl + lalt - l : pmset sleepnow

# Web browser: lalt - w
# lalt - w : open -a "Google Chrome"
lalt - w : open -a "Zen"
